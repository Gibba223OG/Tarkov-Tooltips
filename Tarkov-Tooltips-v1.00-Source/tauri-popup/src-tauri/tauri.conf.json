{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TarkovTooltipsPopup",
  "version": "1.0.0",
  "identifier": "com.pricechecker.tauri.popup",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "popup",
        "title": "Tarkov Tooltips Popup",
        "width": 850,
        "height": 700,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
